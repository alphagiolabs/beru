{
  "name": "beru",
  "version": "1.6.47",
  "description": "Beru",
  "main": "main/main.js",
  "type": "module",
  "os": [
    "win32"
  ],
  "author": "Beru",
  "homepage": "https://beru.app",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && electron-builder --config scripts/electron-builder.config.cjs --win --publish never",
    "build:processor": "node scripts/build-processor.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "node scripts/test-python.mjs",
    "test:coverage": "vitest run --coverage",
    "perf:measure": "node scripts/performance/run.mjs",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "postinstall": "node scripts/fetch-ffmpeg.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-virtual": "^3.14.6",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.460.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "2.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.16",
    "electron": "43.7.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "js-yaml": "4.3.2",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.4.2",
    "shadcn": "^4.13.0",
    "tailwindcss": "^3.4.0",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "app.beru.desktop",
    "productName": "Beru",
    "copyright": "Copyright © 2026 Beru",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main/**/*",
      "shared/**/*",
      "build/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/sax/**/*",
      "node_modules/argparse/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/xlsx/**/*",
      "node_modules/adler-32/**/*",
      "node_modules/cfb/**/*",
      "node_modules/crc-32/**/*",
      "node_modules/codepage/**/*",
      "node_modules/ssf/**/*",
      "node_modules/frac/**/*",
      "node_modules/wmf/**/*",
      "node_modules/word/**/*",
      "resources/**/*",
      "!python/build/**",
      "!python/dist/**",
      "!python/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "resources/encode-profiles.json",
        "to": "encode-profiles.json"
      }
    ],
    "win": {
      "icon": "brand/icon.ico",
      "artifactName": "Beru-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "beforeBuild": "scripts/build-processor.hook.cjs",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es_ES"
      ],
      "uninstallDisplayName": "Beru ${version}",
      "shortcutName": "Beru"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alphagiolabs",
        "repo": "beru",
        "releaseType": "release"
      }
    ]
  }
}
